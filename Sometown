local function walkToTriggerTarget(targetItem)
    local char = lp.Character
    if not char then return "fail" end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return "fail" end

    local beforeCount = getItemCount(currentFarmConfig.folderName)
    local reachTime = tick()

    while working and not isRestocking and not isSellingProcessActive do
        if not targetItem.obj.Parent or not targetItem.part.Parent then return "gone" end

        local targetPos = targetItem.part.Position
        hum:MoveTo(targetPos)

        local currentPos = root.Position
        local diffX, diffZ = targetPos.X - currentPos.X, targetPos.Z - currentPos.Z
        local flatDist = math.sqrt(diffX * diffX + diffZ * diffZ)

        if flatDist <= TOUCH_DIST then
            local qteGui = pg:FindFirstChild("FarmQTEGui")
            local startWait = tick()
            local botTriggered = false

            while working and (tick() - startWait < 0.4) do
                local cur = getItemCount(currentFarmConfig.folderName)
                if cur > beforeCount or (qteGui and qteGui.Enabled) or (hum.WalkSpeed == 0) then
                    botTriggered = true
                    break
                end
                task.wait(0.03)
            end

            if not botTriggered then return "not_triggered" end

            hum:Move(Vector3.zero, false)
            return "bot_started"
        end

        -- เผื่อเวลาตามระยะ (ไกลให้เวลาเดินเพิ่ม สูงสุด +3 วิ)
        if tick() - reachTime > 2.8 + math.min(flatDist / 40, 3) then return "timeout" end
        task.wait(0.03)
    end
    return "stopped"
end

runFarm = function()
    if IN_LOBBY then return end   -- ★ ล็อบบี้ไม่มีแปลงฟาร์ม ห้ามเริ่มฟาร์ม (ไม่งั้นจะวาร์ปหนีออกจากล็อบบี้)
    stopFarm()
    task.wait(0.05)
    working = true

    local function farmLoop()
        while working do
            if isRestocking or isSellingProcessActive then
                task.wait(0.4)
                continue
            end

            local char = lp.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")

            if not root then
                task.wait(0.5)
                continue
            end

            if root and currentFarmConfig then
                local d = root.Position - currentFarmConfig.pos

                -- ใกล้ = เดินไปเก็บเอง | ไกล (รวมตกแมพ เพราะนับแกน Y ด้วย) = วาร์ปกลับจุดฟาร์ม
                if d.Magnitude > currentFarmConfig.maxDist + TP_MARGIN then
                    directTP(currentFarmConfig.pos)
                    standIdle(IDLE_AFTER_TP)
                end
            end

            local cur, maxVal = getItemCount(currentFarmConfig.folderName)
            if cur >= maxVal and maxVal > 0 then
                if autoSellWhenFull then
                    fullSellRoutine(currentFarmConfig.folderName)
                else
                    local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
                    if hum then hum:Move(Vector3.zero, false) end
                    task.wait(1.0)
                end
                continue
            end

            local t = findNonImmediateTarget()
            if not t then
                blacklisted = {}
                task.wait(0.2)
                continue
            end

            local key = itemKey(t)
            local result = walkToTriggerTarget(t)
            if not working then return end

            -- ข้ามก้อนเฉพาะตอน "เดินไปไม่ถึง/เหยียบแล้วบอทไม่เริ่ม" เท่านั้น
            if result == "not_triggered" or result == "timeout" then
                blacklisted[key] = true
                task.wait(0.01)
                continue
            end

            -- บอทเกมเริ่มทำงานแล้ว: ปล่อยให้เกมทำเอง ไม่ยุ่ง
            if result == "bot_started" then
                blacklisted = {}
                local lastItemAcquiredTime = tick()
                local lastItemCount = getItemCount(currentFarmConfig.folderName)

                while working and not isRestocking and not isSellingProcessActive do
                    local qteGui = pg:FindFirstChild("FarmQTEGui")
                    local currentCount = getItemCount(currentFarmConfig.folderName)
                    local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")

                    if currentCount > lastItemCount then
                        lastItemAcquiredTime = tick()
                        lastItemCount = currentCount
                    end

                    local c, m = getItemCount(currentFarmConfig.folderName)
                    if c >= m and m > 0 then break end

                    local isQteClosed = not (qteGui and qteGui.Enabled)
                    local isSpeedNormal = hum and hum.WalkSpeed > 0
                    if isQteClosed and isSpeedNormal and tick() - lastItemAcquiredTime > 0.2 then
                        blacklisted[key] = true
                        break
                    end

                    if (tick() - lastItemAcquiredTime) >= 10.0 then
                        blacklisted[key] = true
                        break
                    end

                    task.wait(0.02)
                end
            end

            task.wait(0.01)
        end
    end

    -- ตัวคุมลูปฟาร์ม: ถ้าลูปพังเพราะ error ให้เริ่มใหม่เอง
    loopThread = task.spawn(function()
        while working do
            local ok = pcall(farmLoop)
            if working and not ok then
                isSellingProcessActive = false
                pcall(function()
                    Camera.CameraType = Enum.CameraType.Custom
                    local h = lp.Character and lp.Character:FindFirstChild("Humanoid")
                    if h then Camera.CameraSubject = h; h:Move(Vector3.zero, false) end
                end)
                task.wait(1)
            end
        end
    end)
end

-- ═══ 10. มินิเกม RADAR QTE ═══
local function getAngleFromCenter(center, point)
    local dir = point - center
    return (math.deg(math.atan2(dir.Y, dir.X)) + 360) % 360
end

local function getAngleDifference(a1, a2)
    local diff = math.abs((a1 - a2) % 360)
    if diff > 180 then diff = 360 - diff end
    return diff
end

local function tapButtonTripleBurst(btn)
    if not (btn and btn.Parent) then
        if UIS.KeyboardEnabled then pressKey(Enum.KeyCode.E, 0.04) end
        return
    end
    task.spawn(function()
        pcall(function()
            local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            local tapPos = Vector3.new(pos.X, pos.Y, 0)

            if firesignal then
                for i = 1, 3 do
                    firesignal(btn.InputBegan, { UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.Begin, Position = tapPos })
                    firesignal(btn.Activated)
                    firesignal(btn.MouseButton1Click)
                    firesignal(btn.InputEnded, { UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.End, Position = tapPos })
                    if i < 3 then task.wait(0.01) end
                end
            end
        end)
    end)
end

local isTappedS1, isTappedS2 = false, false

local qteCache = {}

local qteConn = RS.RenderStepped:Connect(function()
    local qteGui = pg:FindFirstChild("FarmQTEGui")
    if not qteGui then
        isTappedS1, isTappedS2 = false, false
        return
    end
    if not G.QTE_AUTO_ENABLED then
        isTappedS1, isTappedS2 = false, false
        return
    end

    if not qteGui.Enabled then
        isTappedS1, isTappedS2 = false, false
        return
    end

    local qc = qteCache
    if qc.gui ~= qteGui or not (qc.needle and qc.needle.Parent and qc.wheel and qc.wheel.Parent) then
        qc.gui = qteGui
        qc.needle = qteGui:FindFirstChild("NeedleLine", true) or qteGui:FindFirstChild("Keycap", true) or qteGui:FindFirstChild("NeedlePivot", true)
        qc.wheel = qteGui:FindFirstChild("WheelContainer", true) or qteGui:FindFirstChild("TargetArcContainer", true)
        qc.tap, qc.dots, qc.slices = nil, nil, nil
    end
    if not (qc.tap and qc.tap.Parent) then qc.tap = qteGui:FindFirstChild("TapButton", true) end
    if not (qc.dots and qc.dots.Parent) then qc.dots = qteGui:FindFirstChild("StageDots", true) end
    local needle, wheel, tapBtn, stageDots = qc.needle, qc.wheel, qc.tap, qc.dots

    if not needle or not wheel or (not tapBtn and not UIS.KeyboardEnabled) then return end

    local wheelCenter = wheel.AbsolutePosition + (wheel.AbsoluteSize / 2)
    local needleTip = needle.AbsolutePosition + (needle.AbsoluteSize / 2)
    local needleAngle = getAngleFromCenter(wheelCenter, needleTip)

    local dot1 = stageDots and stageDots:FindFirstChild("Dot_1")
    local dot2 = stageDots and stageDots:FindFirstChild("Dot_2")
    local d1G = dot1 and (dot1.BackgroundColor3.G > 0.7 and dot1.BackgroundColor3.R < 0.4) or false
    local d2G = dot2 and (dot2.BackgroundColor3.G > 0.7 and dot2.BackgroundColor3.R < 0.4) or false

    local currentStage = d1G and 2 or 1
    local minDiff = 999

    local nowT = tick()
    if qc.sliceWheel ~= wheel or not qc.slices or nowT - (qc.sliceAt or 0) > 0.1 then
        local list = {}
        for _, d in ipairs(wheel:GetDescendants()) do
            if d.Name == "Slice" and d:IsA("GuiObject") then list[#list + 1] = d end
        end
        qc.slices, qc.sliceWheel, qc.sliceAt = list, wheel, nowT
    end
    for _, child in ipairs(qc.slices) do
        if child.Parent and child.Visible then
            local c = child.BackgroundColor3
            local r, g, b = math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255)

            if r >= 215 and g <= 115 and b <= 115 then
                local sliceCenter = child.AbsolutePosition + (child.AbsoluteSize / 2)
                local diff = getAngleDifference(needleAngle, getAngleFromCenter(wheelCenter, sliceCenter))
                if diff < minDiff then minDiff = diff end
            end
        end
    end

    if d2G then
        -- เสร็จทั้ง 2 สเตจแล้ว
    elseif minDiff <= 5.5 then
        if G.QTE_AUTO_ENABLED then
            if currentStage == 1 and not isTappedS1 then
                isTappedS1 = true
                tapButtonTripleBurst(tapBtn)
            elseif currentStage == 2 and not isTappedS2 then
                isTappedS2 = true
                tapButtonTripleBurst(tapBtn)
            end
        end
    elseif minDiff > 8.0 then
        if currentStage == 1 then isTappedS1 = false end
        if currentStage == 2 then isTappedS2 = false end
    end
end)

-- ═══ 12. FPS BOOST ═══
local fpsOn = false
local fpsConn = nil
local lightBackup = nil

local function optimizeInstance(v)
    if v:IsA("Terrain") then return end
    if v:IsA("BasePart") then
        v.Material = Enum.Material.SmoothPlastic
        v.Reflectance = 0
        v.CastShadow = false
        if v:IsA("MeshPart") then v.RenderFidelity = Enum.RenderFidelity.Performance end
    elseif v:IsA("Decal") or v:IsA("Texture") then
        v.Transparency = 1
    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
        v.Enabled = false
    elseif v:IsA("PostEffect") or v:IsA("Atmosphere") then
        if v:IsA("PostEffect") then v.Enabled = false end
    end
end

local function setFpsBoost(on)
    fpsOn = on
    if fpsConn then fpsConn:Disconnect() fpsConn = nil end

    if on then
        lightBackup = lightBackup or {
            GlobalShadows = Lighting.GlobalShadows,
            FogEnd = Lighting.FogEnd,
            Quality = (function() local ok, q = pcall(function() return settings().Rendering.QualityLevel end) return ok and q or nil end)(),
        }
        pcall(function() Lighting.GlobalShadows = false end)
        pcall(function() Lighting.FogEnd = 9e9 end)
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        pcall(function()
            local t = Workspace.Terrain
            t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance, t.WaterTransparency = 0, 0, 0, 1
        end)

        fpsConn = Workspace.DescendantAdded:Connect(function(v)
            if fpsOn then pcall(optimizeInstance, v) end
        end)

        task.spawn(function()
            local list = Workspace:GetDescendants()
            for i, v in ipairs(list) do
                if not fpsOn then return end
                pcall(optimizeInstance, v)
                if i % 400 == 0 then task.wait() end
            end
            for _, v in ipairs(Lighting:GetDescendants()) do pcall(optimizeInstance, v) end
        end)
    else
        if lightBackup then
            pcall(function() Lighting.GlobalShadows = lightBackup.GlobalShadows end)
            pcall(function() Lighting.FogEnd = lightBackup.FogEnd end)
            if lightBackup.Quality then pcall(function() settings().Rendering.QualityLevel = lightBackup.Quality end) end
            lightBackup = nil
        end
    end
end

