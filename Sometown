G.QTE_AUTO_ENABLED = true

local TOUCH_DIST = 2.4
local blacklisted = {}

-- ★ ใช้ตัว Instance เป็นคีย์ตรงๆ (เดิม GetFullName() ทุกก้อนทุกรอบ ช้ามากเมื่อมีของเยอะ)
local function itemKey(item) return item.obj end

-- ★ แคชชิ้นส่วนที่ใช้เดินไปหา (เดิม FindFirstChild แบบ recursive ทุกก้อนทุกรอบ)
local partCache = setmetatable({}, { __mode = "k" })
local function partOf(d)
    local p = partCache[d]
    if p and p.Parent then return p end
    p = nil
    if d:IsA("BasePart") then
        p = d
    elseif d:IsA("Model") then
        p = d:FindFirstChild("Root", true)
            or d:FindFirstChild("HumanoidRootPart", true)
            or d.PrimaryPart
            or d:FindFirstChildWhichIsA("BasePart", true)
    end
    if p and p.Parent then
        partCache[d] = p
        return p
    end
    return nil
end

local function findNonImmediateTarget()
    local farm = Workspace:FindFirstChild("Farm")
    if not farm or not currentFarmConfig then return nil end

    local targetFolder = farm:FindFirstChild(currentFarmConfig.folderName)
    if not targetFolder then return nil end

    local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local rootPos = root.Position
    local farmPos = currentFarmConfig.pos
    local maxDist = currentFarmConfig.maxDist

    local best, bestDist = nil, math.huge
    local fallback, fallbackDist = nil, math.huge

    for _, d in ipairs(targetFolder:GetChildren()) do
        if blacklisted[d] then continue end

        local part = partOf(d)
        if not part then continue end

        local pos = part.Position
        if (pos - farmPos).Magnitude > maxDist then continue end

        local dist = (pos - rootPos).Magnitude
        if dist < fallbackDist then fallback, fallbackDist = d, dist end
        if dist >= 4.0 and dist < bestDist then best, bestDist = d, dist end
    end

    local pick = best or fallback
    if not pick then return nil end
    return { obj = pick, part = partOf(pick), name = pick.Name }
end

stopFarm = function()
    working = false
    NC.farm = false
    if NC.hold then endNoclip() end   -- เธรดขายถูกหยุดกลางคัน ต้องคืนการชน
    if loopThread then
        task.cancel(loopThread)
        loopThread = nil
        isSellingProcessActive = false   -- ขั้นตอนขายรันในเธรดฟาร์ม: ถ้าเธรดถูกหยุดกลางคัน ต้องล้างธงค้าง
    end
    -- ★ เธรดวาร์ปถูกหยุดกลางคัน: ปลดล็อกตัว (Anchored) + คืนการชนทันที ไม่ต้องรอ watchdog
