-- เซิร์ฟรีสตาร์ททุก 00:00 / 06:00 / 12:00 / 18:00 (เวลาไทย UTC+7)
local TZ_OFFSET = 7
local RESTART_HOURS = {0, 6, 12, 18}
local RESTART_LEAD = 90         -- เข้าล็อบบี้ก่อนรีสตาร์ท 90 วิ (เผื่อวาร์ปช้า/ลองซ้ำ)
local RESTART_HOLD_AFTER = 45   -- ล็อบบี้รอหลังรีสตาร์ท 45 วิ ค่อยเลือกเซิร์ฟใหม่

-- เวลาที่เชื่อถือได้: ใช้เวลาเซิร์ฟเวอร์ Roblox
local function nowUnix()
    local ok, t = pcall(function() return Workspace:GetServerTimeNow() end)
    if ok and type(t) == "number" and t > 1e9 then
        return math.floor(t)
    end
    return os.time()
end

-- คืนค่า (วินาทีก่อนรีสตาร์ทรอบหน้า, วินาทีนับจากรีสตาร์ทรอบล่าสุด)
local function restartTimes()
    local t = os.date("!*t", nowUnix() + TZ_OFFSET * 3600)
    local nowSec = t.hour * 3600 + t.min * 60 + t.sec
    local untilNext, sinceLast = math.huge, math.huge
    for _, h in ipairs(RESTART_HOURS) do
        local d = h * 3600 - nowSec
        if d <= 0 then d = d + 86400 end
        if d < untilNext then untilNext = d end
        local s = nowSec - h * 3600
        if s < 0 then s = s + 86400 end
        if s < sinceLast then sinceLast = s end
    end
    return untilNext, sinceLast
end

local function inRestartHold()
    local untilNext, sinceLast = restartTimes()
    return untilNext <= RESTART_LEAD or sinceLast < RESTART_HOLD_AFTER
end

local lobbyDiagAt = 0

-- สำรอง: ถ้าอ่านรายชื่อเซิร์ฟจาก ReplicatedStorage ไม่ได้ ให้อ่านจากหน้า UI เลือกเซิร์ฟแล้วกดปุ่มเล่นของเซิร์ฟที่คนน้อยสุดเอง
local function uiFallbackJoin()
    local best, bestOnline = nil, 9999
    for _, d in ipairs(lp.PlayerGui:GetDescendants()) do
        if d.Name == "playBT" and d:IsA("GuiObject") then
            local node, online, maxv = d.Parent, nil, nil
            for _ = 1, 5 do
                if not node or node == lp.PlayerGui then break end
                for _, t in ipairs(node:GetDescendants()) do
                    if t:IsA("TextLabel") then
                        local a, b = t.Text:match("(%d+)%s*/%s*(%d+)")
                        if a and b then online, maxv = tonumber(a), tonumber(b) break end
                    end
                end
                if online then break end
                node = node.Parent
            end
            if online and maxv and online < maxv - 1 and online < bestOnline then
                best, bestOnline = d, online
            end
        end
    end
    if best then
        print("[JH-LOBBY] UI fallback: join server online=" .. bestOnline)
        triggerNativeButton(best)
        return true
    end
    return false
end

local function runLobbyHopperLoop()
    if not IN_LOBBY then return end

    task.spawn(function()
        task.wait(3.0)
        while gui.Parent and IN_LOBBY do
            if inRestartHold() then   -- ใกล้รีสตาร์ท/เพิ่งรีสตาร์ท: รอก่อน
                task.wait(1.0)
                continue
            end
            local serversFolder = ReplicatedStorage:FindFirstChild("Servers")
            local func = ReplicatedStorage:FindFirstChild("func")

            -- บันทึกลง Developer Console (F9) ทุก 15 วิ ไว้ดูว่าเกมเปลี่ยนโครงสร้างรายชื่อเซิร์ฟไหม
            if tick() - (lobbyDiagAt or 0) > 15 then
                lobbyDiagAt = tick()
                pcall(function()
                    print(string.format("[JH-LOBBY] Servers=%s func=%s", tostring(serversFolder ~= nil), tostring(func ~= nil)))
                    if serversFolder then
                        local n = 0
                        for _, d in ipairs(serversFolder:GetDescendants()) do
                            n = n + 1
                            if n > 12 then break end
                            print(string.format("[JH-LOBBY]  %s (%s) Online=%s Value=%s", d:GetFullName():gsub("^.-Servers", "Servers"),
                                d.ClassName, tostring(d:GetAttribute("Online")),
                                tostring(pcall(function() return d.Value end) and d.Value or ""):sub(1, 24)))
                        end
                    else
                        local names = {}
                        for _, c in ipairs(ReplicatedStorage:GetChildren()) do names[#names + 1] = c.Name end
                        print("[JH-LOBBY] ReplicatedStorage: " .. table.concat(names, ", "))
                    end
                end)
            end

            local joined = false
            if serversFolder and func then
                local bestServerName, bestToken = nil, nil
                local lowestOnline = 9999

                for _, sVal in ipairs(serversFolder:GetDescendants()) do
                    if sVal.Name:upper():find("^SERVER%s*%d+") then
                        local online = sVal:GetAttribute("Online") or 0
                        local rawVal = tostring(sVal.Value or "")

                        if online < 49 and rawVal ~= "" then
                            local token = rawVal:match("^(%S+)")
                            if token and online < lowestOnline then
                                lowestOnline = online
                                bestServerName = sVal.Name
                                bestToken = token
                            end
                        end
                    end
                end

                if bestServerName and bestToken then
                    joined = true
                    task.wait(1.0)
                    pcall(function()
                        if not writefile then return end
                        if makefolder and isfolder and not isfolder(FOLDER) then makefolder(FOLDER) end
                        writefile(FOLDER .. "/viaLobby.txt", tostring(os.time()))
                    end)
                    pcall(function() func:InvokeServer("teleport", bestToken) end)

                    pcall(function()
                        local serverlistUI = lp.PlayerGui:FindFirstChild("serverlistUI")
                        if serverlistUI then
                            local scroll = serverlistUI:FindFirstChild("scroll", true)
                            local serverFrame = scroll and scroll:FindFirstChild(bestServerName)
                            local playBtn = serverFrame and serverFrame:FindFirstChild("playBT", true)
                            if playBtn then triggerNativeButton(playBtn) end
                        end
                    end)
                end
            end
            if not joined then pcall(uiFallbackJoin) end
            task.wait(5.0)
        end
    end)
end

