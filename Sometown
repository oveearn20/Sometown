local function readItemCount(targetName)
    local curCount, maxCount = 0, 999
    pcall(function()
        local body = getInvBody()
        if not body then return end

        local targetSlot = body:FindFirstChild(targetName)
        if not targetSlot then
            local aliases = MARKET_ITEM_NAMES[targetName] or {targetName}
            for _, name in ipairs(aliases) do
                local f = body:FindFirstChild(name)
                if f then targetSlot = f break end
            end
        end
        if not targetSlot then return end

        for _, desc in ipairs(targetSlot:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text ~= "" then
                local cur, maxVal = desc.Text:match("(%d+)%s*/%s*(%d+)")
                if cur and maxVal then
                    curCount = tonumber(cur) or 0
                    maxCount = tonumber(maxVal) or 999
                    return
                else
                    local single = desc.Text:match("(%d+)")
                    if single then curCount = tonumber(single) or 0 end
                end
            end
        end
    end)
    return curCount, maxCount
end

-- cache สั้นๆ: หลายลูปเรียกบ่อยมาก ลดการสแกน GUI ซ้ำ แต่ยังทันต่อการเก็บของ
local itemCache = {}
local ITEM_TTL = 0.05
local function getItemCount(targetName)
    local now = tick()
    local c = itemCache[targetName]
    if c and now - c.t < ITEM_TTL then return c.cur, c.max end
    local cur, maxVal = readItemCount(targetName)
    itemCache[targetName] = { cur = cur, max = maxVal, t = now }
    return cur, maxVal
end

