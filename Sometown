local function readStatus(statType)
    local aliases = (statType == "Thirst") and {"Thirsty", "Thirst", "Water"} or {"Hunger", "Food", "Hungry"}

    for _, name in ipairs(aliases) do
        local attr = lp:GetAttribute(name)
        if attr ~= nil then return tonumber(attr) or 100 end

        local statusFolder = lp:FindFirstChild("Status") or lp:FindFirstChild("Stats")
        if statusFolder then
            local obj = statusFolder:FindFirstChild(name)
            if obj and obj:IsA("ValueBase") then return tonumber(obj.Value) or 100 end
            if statusFolder:GetAttribute(name) ~= nil then
                return tonumber(statusFolder:GetAttribute(name)) or 100
            end
        end
    end

    local mainUI = pg:FindFirstChild("MainUI") or pg:FindFirstChild("StatusUI")
    if mainUI then
        for _, desc in ipairs(mainUI:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text:find("%%") then
                local num = desc.Text:match("(%d+%.?%d*)%%")
                if num then return tonumber(num) or 100 end
            end
        end
    end
    return 100
end

local statCache = {}
local STAT_TTL = 0.4
local function getNormalizedStatus(statType)
    local now = tick()
    local c = statCache[statType]
    if c and now - c.t < STAT_TTL then return c.v end
    local v = readStatus(statType)
    statCache[statType] = { v = v, t = now }
    return v
end

