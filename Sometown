local invBodyRef = nil
local function getInvBody()
    if invBodyRef and invBodyRef.Parent then return invBodyRef end
    local inv = pg:FindFirstChild("Inventory")
    local canvas = inv and inv:FindFirstChild("CanvasGroup")
    local mainF = canvas and canvas:FindFirstChild("Main")
