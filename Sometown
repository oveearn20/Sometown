local CONSUME_SETTINGS = { Enabled = true, Threshold = 80, Cooldown = 1.0 }
local isConsumeBusy = false

local function consumeItem(itemName)
    local invGui = pg:FindFirstChild("Inventory")
    local invHandler = invGui and invGui:FindFirstChild("Handler")

    if invHandler and type(getsenv) == "function" then
        local envSuccess, env = pcall(getsenv, invHandler)
        if envSuccess and type(env) == "table" and type(env.UseItem) == "function" then
            local ok = pcall(env.UseItem, itemName)
            if ok then return true end
        end
    end

    if invGui and type(firesignal) == "function" then
        local cg = invGui:FindFirstChild("CanvasGroup")
        local mainF = cg and cg:FindFirstChild("Main")
        local body = mainF and mainF:FindFirstChild("Body")
        local options = cg and cg:FindFirstChild("Options")
        local optMain = options and options:FindFirstChild("Main")
        local useBtn = optMain and optMain:FindFirstChild("Use")

        if cg and not cg.Visible then
            local f2Btn = pg:FindFirstChild("UIList")
                and pg.UIList:FindFirstChild("MobileButton")
                and pg.UIList.MobileButton:FindFirstChild("F2")
                and pg.UIList.MobileButton.F2:FindFirstChild("TextButton")
            if smartPress(f2Btn, Enum.KeyCode.F2, 0.08) then
                task.wait(0.15)
            end
        end

        local itemFrame = body and body:FindFirstChild(itemName)
        local itemBtn = itemFrame and itemFrame:FindFirstChild("Main")

        if itemBtn and useBtn then
            firesignal(itemBtn.Activated)
            task.wait(0.1)
            firesignal(useBtn.Activated)
            firesignal(useBtn.MouseButton1Click)
            return true
        end
    end
    return false
end

local function consumeLoop()
    while gui.Parent do
        task.wait(0.5)

        -- ★ ล็อบบี้ / กำลังย้ายเซิร์ฟ / กำลังรีจอยน์ → ไม่กิน ไม่ซื้อเสบียง
        if CONSUME_SETTINGS.Enabled and not IN_LOBBY and not SAFE.hopping and not rejoining
            and not isConsumeBusy and not isRestocking and not isSellingProcessActive then
            local thirstPct = getNormalizedStatus("Thirst")
            local hungerPct = getNormalizedStatus("Hunger")
            local waterCount = getItemCount("Water")
            local breadCount = getItemCount("Bread")

            local needWater = (thirstPct <= CONSUME_SETTINGS.Threshold)
            local needBread = (hungerPct <= CONSUME_SETTINGS.Threshold)

            if (needWater and waterCount <= 0) or (needBread and breadCount <= 0) then
                if not pcall(executeRestockRoutine, waterCount, breadCount) then
                    isRestocking = false
                    Camera.CameraType = Enum.CameraType.Custom
                end
                task.wait(0.8)
                continue
            end

            if needWater and waterCount > 0 then
                isConsumeBusy = true
                task.spawn(function()
                    while CONSUME_SETTINGS.Enabled and getNormalizedStatus("Thirst") < 99 and not isRestocking do
                        if getItemCount("Water") <= 0 then break end
                        consumeItem("Water")
                        task.wait(CONSUME_SETTINGS.Cooldown)
                    end
                    isConsumeBusy = false
                end)
            elseif needBread and breadCount > 0 then
                isConsumeBusy = true
                task.spawn(function()
                    while CONSUME_SETTINGS.Enabled and getNormalizedStatus("Hunger") < 99 and not isRestocking do
                        if getItemCount("Bread") <= 0 then break end
                        consumeItem("Bread")
                        task.wait(CONSUME_SETTINGS.Cooldown)
                    end
                    isConsumeBusy = false
                end)
            end
        end
    end
end

