local IDLE_BEFORE_TP = 2.0   -- ยืนนิ่งก่อนวาร์ปทุกครั้ง
local IDLE_AFTER_TP  = 1.5   -- ยืนนิ่งหลังถึงจุดฟาร์ม ก่อนเดินไปเก็บ

local function standIdle(sec)
    local t0 = tick()
    while tick() - t0 < (sec or IDLE_AFTER_TP) do
        local char = lp.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then break end
        hum:Move(Vector3.zero, false)
        hum:MoveTo(root.Position)   -- ยกเลิกเป้าหมายเดินเดิมที่ค้างอยู่
        task.wait(0.1)
    end
end

-- ═══ 0.2 ระบบเช็ควิ่งอัตโนมัติ (เช็คสถานะตลอดเวลา) ═══
local RUN_SETTLE = 1.5
local RUN_FAIL_COOLDOWN = 10
local RUN_CHECK_INTERVAL = 0.1   -- เช็คทุก 0.1 วิ
local walkSpd, runSpd = nil, nil
local runHum, runBelief, runPending, runPressAt, runNextAt = nil, false, nil, 0, 0
local runSpeedConn = nil
local runBusy = false            -- กันเรียกซ้อน (ลูป + สัญญาณ WalkSpeed) ไม่ให้กดปุ่มวิ่งสองรอบแล้วสลับเป็นเดิน
local runStep

-- อัปเดตความเชื่อ "ตอนนี้วิ่งอยู่ไหม" จาก WalkSpeed ปัจจุบัน (ทำได้แม้ยืนนิ่ง)
local function syncRunBelief(ws)
    if walkSpd and runSpd then
        local gap = runSpd - walkSpd
        if ws >= walkSpd + gap * 0.5 then
            runBelief = true
        elseif ws <= walkSpd + gap * 0.15 and ws >= walkSpd - 0.5 then
            runBelief = false   -- ต้องใกล้ความเร็วเดินจริงๆ ถึงถือว่าไม่ได้วิ่ง (ของหนัก/บัฟทำให้ความเร็วเพี้ยน)
        end
    end
end

local function runStepInner()
    local char = lp.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return end

    if hum ~= runHum then
        runHum, runBelief, runPending, runPressAt, runNextAt = hum, false, nil, 0, 0
        if runSpeedConn then runSpeedConn:Disconnect() end
        -- WalkSpeed เปลี่ยนเมื่อไหร่ เช็คสถานะทันที ไม่ต้องรอรอบลูป
        runSpeedConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            pcall(runStep)
        end)
    end

    local ws = hum.WalkSpeed
    if hum.Sit or ws <= 0 then return end

    local now = tick()

    -- ตรวจผลหลังกดปุ่มวิ่ง (ทำตลอด ไม่ต้องรอให้ขยับ)
    if runPending then
        if now - runPressAt < 1.0 then return end
        local before = runPending
        runPending = nil
        if ws > before + 0.5 then
            walkSpd, runSpd, runBelief = before, ws, true
        elseif walkSpd and runSpd then
            runBelief = false
            runNextAt = now + RUN_FAIL_COOLDOWN
        elseif ws < before - 0.5 then
            runSpd, walkSpd, runBelief = before, ws, false
        else
            runBelief = true
        end
        return
    end

    -- เช็คสถานะวิ่งจากความเร็วตลอดเวลา แม้ยืนนิ่ง (เกมอาจปิดวิ่งเองตอนหยุด/วาร์ป/เกิดใหม่)
    syncRunBelief(ws)

    -- กดปุ่มวิ่งเฉพาะตอนกำลังเดินจริง
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local vel = rootPart and rootPart.AssemblyLinearVelocity or Vector3.zero
    local flatVel = Vector3.new(vel.X, 0, vel.Z).Magnitude
    if hum.MoveDirection.Magnitude < 0.1 and flatVel < 2 then return end

    if runBelief or now < runNextAt then return end
    if triggerMobileRunButton() then
        runBelief, runPending, runPressAt = true, ws, now
        runNextAt = now + RUN_SETTLE
    else
        runNextAt = now + 2
    end
end

runStep = function()
    if runBusy then return end
    runBusy = true
    pcall(runStepInner)
    runBusy = false
end

task.spawn(function()
    while gui.Parent do
        task.wait(RUN_CHECK_INTERVAL)
        runStep()
    end
end)

-- ═══ 0.3 NOCLIP ═══
-- เปิดเฉพาะตอนวาร์ป (tpUntil) | ปิดทันทีที่ลงถึง (endNoclip) โดยคืน CanCollide เฉพาะชิ้นที่สคริปต์ปิดเอง
-- busyUntil = ช่วงที่ตัวเช็คต่างๆ ห้ามยุ่ง (วาร์ปอยู่)
local NC = { tpUntil = 0, busyUntil = 0, farm = false, hold = false, anchored = false }   -- hold = คง noclip ไว้ตอนขายของ
local ncChanged = {}
local noclipConn
noclipConn = RS.Stepped:Connect(function()
    if not gui.Parent then
        noclipConn:Disconnect()
        return
    end
    if not NC.farm and not NC.hold and tick() >= NC.tpUntil then return end
    local char = lp.Character
    if not char then return end
    for _, p in ipairs(char:GetChildren()) do
        if p:IsA("BasePart") and p.CanCollide then
            ncChanged[p] = true
            p.CanCollide = false
        end
    end
end)

local function tpBeat()
    NC.tpUntil = tick() + 4
    NC.busyUntil = NC.tpUntil
end

local function busyBeat(sec)
    local t = tick() + (sec or 4)
    if t > NC.busyUntil then NC.busyUntil = t end
end

local function endNoclip()
    NC.tpUntil = 0
    NC.farm = false
    NC.hold = false
    for p in pairs(ncChanged) do
        if p.Parent then p.CanCollide = true end
    end
    ncChanged = {}
end

-- ═══ 1. วาร์ป ═══
local TP_STEP  = 1200   -- ระยะวาร์ปต่อก้าว (studs)
local TP_DEPTH = 40     -- ความลึกใต้ดิน

-- รอจนมีพื้นจริงใต้ตัว (ไม่นับแผ่นรอง/น้ำ) คืนผล raycast หรือ nil ถ้าไม่เจอในเวลาที่กำหนด
local function waitGround(char, pad, pos, maxSec, beat)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {char, pad}
    rp.IgnoreWater = true
    local t0, hit = tick(), nil
    repeat
        if beat then beat() end
        hit = Workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -14, 0), rp)
        if hit then break end
        task.wait(0.1)
    until tick() - t0 > maxSec
    return hit
end

local function undergroundHop(char, root, hum, targetPos, stepDistance, startPos, keepNoclip)
    local flat = Vector3.new(targetPos.X - startPos.X, 0, targetPos.Z - startPos.Z)
    local flatDist = flat.Magnitude
    local steps = math.max(1, math.ceil(flatDist / stepDistance))
    local dir = flatDist > 0.01 and flat.Unit or Vector3.zero
    local depthY = math.min(startPos.Y, targetPos.Y) - TP_DEPTH

    local function placeAt(cf)
        root.CFrame = cf
        char:PivotTo(cf)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    tpBeat()
    root.Anchored = true
    NC.anchored = true

    -- 1) ดิ่งลงใต้ดินตรงจุดที่ยืนอยู่
    placeAt(CFrame.new(startPos.X, depthY, startPos.Z))
    task.wait(0.15)

    -- 2) เลื่อนใต้ดินทีละก้าว
    for i = 1, steps - 1 do
        if not root.Parent then return end
        tpBeat()
        placeAt(CFrame.new(startPos.X + dir.X * stepDistance * i, depthY, startPos.Z + dir.Z * stepDistance * i))
        task.wait(0.35)
    end

    -- 3) ไปอยู่ใต้เป้าหมาย สั่งโหลดแมพตรงนั้น แล้วรอก่อนโผล่
    if not root.Parent then return end
    tpBeat()
    placeAt(CFrame.new(targetPos.X, depthY, targetPos.Z))
    pcall(function() lp:RequestStreamAroundAsync(targetPos, 2) end)
    task.wait(0.4)
    if not root.Parent then return end

    -- 4) โผล่ที่พิกัดเป้าหมายตรงๆ + แผ่นรองกันตก ล็อกตัวไว้จนเจอพื้นจริง
    local landCF = CFrame.new(targetPos.X, targetPos.Y, targetPos.Z)

    local pad = Instance.new("Part")
    pad.Name = "SafeLandingPad"
    pad.Size = Vector3.new(10, 1, 10)
    pad.CFrame = landCF * CFrame.new(0, -3.0, 0)
    pad.Anchored = true
    pad.Transparency = 1
    pad.CanCollide = true
    pad.Parent = Workspace
    task.delay(15, function() if pad.Parent then pad:Destroy() end end)

    tpBeat()
    placeAt(landCF)
    local hit = waitGround(char, pad, landCF.Position, 3, tpBeat)   -- ยังล็อกตัวอยู่ระหว่างรอ
    root.Anchored = false
    NC.anchored = false
    hum:ChangeState(Enum.HumanoidStateType.Landed)

    task.wait(0.6)
    if hit and pad.Parent then pad:Destroy() end   -- เจอพื้นจริงถึงลบแผ่น ไม่เจอก็ปล่อยให้ยืนบนแผ่น
    root.AssemblyLinearVelocity = Vector3.zero
    if keepNoclip then NC.hold = true else endNoclip() end   -- keepNoclip = คง noclip ไว้ (ตอนขายของ)
end

-- idleSec: nil = ยืนนิ่ง IDLE_BEFORE_TP วิก่อนวาร์ป | 0 = ข้าม | ตัวเลขอื่น = ยืนนิ่งตามนั้น
local function executeHopTeleport(targetPos, stepDistance, preWait, idleSec, keepNoclip)
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    hum.Sit = false
    if idleSec == nil then idleSec = IDLE_BEFORE_TP end
    if idleSec > 0 then standIdle(idleSec) end
    if not root.Parent or hum.Health <= 0 then return end

    local startPos = root.Position
    if (targetPos - startPos).Magnitude < 1 then return end

    pcall(undergroundHop, char, root, hum, targetPos, stepDistance or TP_STEP, startPos, keepNoclip)
    pcall(function()
        if root.Parent then root.Anchored = false end
        NC.anchored = false
    end)
    if keepNoclip then NC.hold = true else endNoclip() end
    task.wait(0.15)
end

-- วาร์ปขากลับ: ใช้ระบบเดียวกัน
local function executeUndergroundReturn(targetPos, stepDistance, idleSec)
    return executeHopTeleport(targetPos, stepDistance, nil, idleSec)
end

-- วาร์ปตรง (ใช้ตอนแก้ค้าง/ตกน้ำ): ล็อกตัวไว้จนเจอพื้นจริง ไม่ทะลุ
local lastAutoTP = 0          -- เวลาวาร์ปอัตโนมัติครั้งล่าสุด (ใช้กันวาร์ปรัว)
local TP_MARGIN  = 60         -- ระยะเผื่อเกิน maxDist ก่อนถือว่า "ไกลเกิน" (กันขอบเขตกระตุก)
local function directTP(pos)
    lastAutoTP = tick()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    local pad, hit
    busyBeat(8)
    NC.anchored = true
    pcall(function()
        root.Anchored = true
        pcall(function() lp:RequestStreamAroundAsync(pos, 3) end)

        local cf = CFrame.new(pos.X, pos.Y + 3, pos.Z)
        pad = Instance.new("Part")
        pad.Name = "SafeLandingPad"
        pad.Size = Vector3.new(16, 1, 16)
        pad.CFrame = cf * CFrame.new(0, -3.5, 0)
        pad.Anchored = true
        pad.Transparency = 1
        pad.CanCollide = true
        pad.Parent = Workspace
        task.delay(20, function() if pad and pad.Parent then pad:Destroy() end end)

        char:PivotTo(cf)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        hit = waitGround(char, pad, cf.Position, 4, function() busyBeat(6) end)
    end)
    pcall(function() if root.Parent then root.Anchored = false end end)
    NC.anchored = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Landed) end)
    task.wait(0.4)
    if hit and pad and pad.Parent then pad:Destroy() end
    endNoclip()
end

