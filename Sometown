local function Dropdown(page, str, options, flag, default, cb)
    local cur = saved(flag, default)
    if not table.find(options, cur) then cur = default end

    local holder = new("Frame", {Size = UDim2.new(1, 0, 0, 36), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1}, page)
    new("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, holder)

    local head = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.white,
        Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 1}, holder)
    round(head, 10)
    grad(head, Color3.fromRGB(14, 30, 74), Color3.fromRGB(5, 10, 28), 90)
    local hs = stroke(head, C.blue, 1.1, 0.5)
    local title = text(head, "", 12, Enum.Font.GothamBold, {Position = UDim2.fromOffset(11, 0),
        Size = UDim2.new(1, -34, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
    local arrow = text(head, "v", 12, Enum.Font.GothamBold, {AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(14, 20)})

    local list = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Visible = false, LayoutOrder = 2}, holder)
    new("UIListLayout", {Padding = UDim.new(0, 4)}, list)
    new("UIPadding", {PaddingLeft = UDim.new(0, 10)}, list)

    local function pick(v, fire)
        cur = v
        title.Text = str .. ": " .. v
        CFG[flag] = v
        if fire and cb then task.spawn(cb, v) end
    end

    for _, opt in ipairs(options) do
        local b = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.deep,
            Size = UDim2.new(1, 0, 0, 30)}, list)
        round(b, 8)
        stroke(b, C.blue, 1, 0.6)
        text(b, opt, 12, Enum.Font.GothamBold, {Position = UDim2.fromOffset(10, 0),
            Size = UDim2.new(1, -14, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
        b.MouseButton1Click:Connect(function()
            pick(opt, true)
            save()
            list.Visible = false
            arrow.Text = "v"
        end)
