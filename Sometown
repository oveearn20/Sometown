--========== config save/load ==========
local FOLDER = "JustHubLite"
local FILE   = FOLDER .. "/AutoFarm.json"
local CFG    = {}

-- อ่านไฟล์ config: ไฟล์พัง/ว่าง/ไม่ใช่ table → คืน nil (ไม่ทำให้สคริปต์ล้ม)
local function readCfg(path)
    local ok, data = pcall(function()
        if isfile and isfile(path) then
            return HttpService:JSONDecode(readfile(path))
        end
    end)
    if ok and type(data) == "table" then return data end
    return nil
end
CFG = readCfg(FILE) or readCfg(FILE .. ".bak") or {}

local function saved(flag, def)
    local v = CFG[flag]
    if v == nil then return def end
    return v
end

-- เขียนไฟล์สำรองก่อน แล้วค่อยเขียนไฟล์จริง (ถ้าเครื่องดับกลางคัน ยังมีไฟล์ใดไฟล์หนึ่งที่สมบูรณ์เสมอ)
local lastJson = nil
local function save()
    pcall(function()
        if not writefile then return end
        local json = HttpService:JSONEncode(CFG)
        if json == lastJson then return end   -- ไม่มีอะไรเปลี่ยน ไม่ต้องเขียนซ้ำ
        if makefolder and isfolder and not isfolder(FOLDER) then makefolder(FOLDER) end
        writefile(FILE .. ".bak", json)
        writefile(FILE, json)
        lastJson = json
    end)
end
