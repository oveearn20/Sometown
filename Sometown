    local rs = stroke(row, C.blue, 1.1, 0.5)
    text(row, str, 12, Enum.Font.GothamBold, {Position = UDim2.fromOffset(11, 0),
        Size = UDim2.new(1, -62, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})

    local track = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0),
        Size = UDim2.fromOffset(40, 21), BackgroundColor3 = Color3.fromRGB(18, 30, 66)}, row)
    round(track, 11)
    local ts = stroke(track, C.blue, 1.1, 0.5)
    local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 11, 0.5, 0),
        Size = UDim2.fromOffset(15, 15), BackgroundColor3 = Color3.fromRGB(130, 160, 210)}, track)
    round(knob, 8)

    local function render(anim)
        local d = anim and 0.2 or 0
        tw(track, d, {BackgroundColor3 = state and C.blue or Color3.fromRGB(18, 30, 66)})
        tw(ts, d, {Color = state and C.glow or C.blue, Transparency = state and 0 or 0.5})
        tw(rs, d, {Color = state and C.bright or C.blue, Transparency = state and 0.15 or 0.5})
        tw(knob, d, {Position = UDim2.new(0, state and 29 or 11, 0.5, 0),
            BackgroundColor3 = state and C.white or Color3.fromRGB(130, 160, 210)})
    end
    render(false)
    CFG[flag] = state
    tinits[#tinits + 1] = function() if cb then cb(state) end end

    row.MouseEnter:Connect(function() tw(rs, 0.15, {Transparency = 0.15}) end)
    row.MouseLeave:Connect(function() tw(rs, 0.15, {Transparency = state and 0.15 or 0.5}) end)
    row.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        CFG[flag] = state
        save()
        if cb then task.spawn(cb, state) end
    end)
end

