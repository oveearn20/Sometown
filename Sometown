-- บอทเกมกำลังฟาร์มอยู่ไหม (ถ้าใช่ ห้ามวาร์ป/ห้ามยุ่ง)
local function gameBotWorking()
    local qte = pg:FindFirstChild("FarmQTEGui")
    if qte and qte.Enabled then return true end
    local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
    if hum and hum.WalkSpeed == 0 then return true end
    return false
end

-- วิ่งกลับจุดฟาร์ม คืน true ถ้าถึง/บอทเริ่มทำงาน | false ถ้าไม่ถึงภายในเวลา
local function runBackTo(pos, maxSec, stopDist)
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not root or not hum then return false end
    local t0 = tick()
    local lastP, lastT = root.Position, tick()
    while tick() - t0 < maxSec do
        if gameBotWorking() then return true end
        if not root.Parent or hum.Health <= 0 then return false end
        local d = root.Position - pos
        if Vector3.new(d.X, 0, d.Z).Magnitude <= (stopDist or 15) then
            hum:Move(Vector3.zero, false)
            return true
        end
        hum:MoveTo(pos)
        -- ติดสิ่งกีดขวาง: ไม่ขยับ 1.5 วิ ให้กระโดด
        if (root.Position - lastP).Magnitude > 1.5 then
            lastP, lastT = root.Position, tick()
        elseif tick() - lastT > 1.5 then
            hum.Jump = true
            lastT = tick()
        end
        task.wait(0.1)
    end
    return false
end

-- ═══ 1.5 ระบบเช็คคนใกล้ ═══
local SAFE = { radius = 10, waitMax = 120, suspectRange = 40, suspects = {}, armed = false, hopping = false }

local function playersNear(pos, radius)
    local found = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local c = p.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if r and (r.Position - pos).Magnitude <= radius then
                found = found or {}
                found[#found + 1] = p
            end
        end
    end
    return found
end

local function holdStillUntilClear(getPos, onSeen, shouldStop)
    local startWait = tick()
    local clearSince = startWait
    while true do
        if shouldStop and shouldStop() then return false end
        local char = lp.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then return false end

        hum:Move(Vector3.zero, false)
        hum:MoveTo(root.Position)

        local pos = getPos and getPos(root) or nil
        local near = pos and playersNear(pos, SAFE.radius) or nil
        local now = tick()
        if near then
            clearSince = now
            if onSeen then pcall(onSeen, near) end
        end
        if now - clearSince >= IDLE_BEFORE_TP then return true end
        if now - startWait >= SAFE.waitMax then return true end
        task.wait(0.1)
    end
end

