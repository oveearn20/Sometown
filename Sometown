local function walkAwayFromPoint(originPos, distToMove)
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    local diff = (root.Position - originPos)
    local flatDir = Vector3.new(diff.X, 0, diff.Z)
    if flatDir.Magnitude < 0.5 then
        flatDir = -root.CFrame.LookVector
    else
        flatDir = flatDir.Unit
    end

    local escapeTarget = root.Position + (flatDir * (distToMove or 35))
    hum:MoveTo(escapeTarget)

    local startMove = tick()
    while tick() - startMove < 2.5 do
        local curDist = (root.Position - originPos).Magnitude
        if curDist >= (distToMove or 35) or (root.Position - escapeTarget).Magnitude <= 3.5 then break end
        task.wait(0.05)
    end

    hum:Move(Vector3.zero, false)
    root.AssemblyLinearVelocity = Vector3.zero
end

